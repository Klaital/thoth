DB_DSN=user:password@tcp(db-host:3306)/thoth?parseTime=true&interpolateParams=true
JWT_SECRET=change-me-to-a-random-256-bit-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://thoth.example.com/auth/google/callback
GOUPC_API_KEY=

# --- Docker / compose ---
# Public URL of the SPA, used for OAuth redirects.
FRONTEND_URL=http://localhost:8080
# Host port the web container publishes (prod: 127.0.0.1 only, behind host nginx;
# must match app_port in deploy/ansible/group_vars/all.yml).
HTTP_PORT=8080
# Local-only MySQL container (compose.override.yaml). With it, DB_DSN above becomes
#   thoth:<MYSQL_PASSWORD>@tcp(db:3306)/thoth?parseTime=true&interpolateParams=true
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_USER=thoth
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=thoth

# --- Telemetry (OpenTelemetry) ---
# Off unless an OTLP endpoint is set. Prod: Grafana Cloud > your stack >
# OpenTelemetry > Configure gives the endpoint and a base64 instanceID:token.
# Local: `docker compose --profile observability up -d` and use otel-lgtm.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-west-0.grafana.net/otlp
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instanceID:token>
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
