# Go
/bin/
/tmp/
*.exe
*.test
*.out
vendor/

# Generated (buf + sqlc). List generated files explicitly: hand-written code
# lives alongside them (internal/db/connect.go, frontend/src/gen/google/).
internal/gen/
internal/db/*.sql.go
internal/db/db.go
internal/db/models.go
internal/db/querier.go
# `gen/*` rather than `gen/` so the exception below can apply; git can't
# re-include files inside an ignored directory.
frontend/src/gen/*
!frontend/src/gen/google/

# Frontend
frontend/node_modules/
frontend/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
