#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Deploy a Thoth release: pull the images tagged <git-sha> from ECR and
# restart the compose stack in {{ app_dir }}.
#
#   tar -c compose.yaml compose.prod.yaml | ssh {{ deploy_user }}@host <git-sha>   # CI (forced command)
#   thoth-deploy <git-sha> < /dev/null                                       # on the host, reuse current compose files
#
# The compose files arrive as a tar on stdin so they always match the release.
set -euo pipefail

tag="${SSH_ORIGINAL_COMMAND:-${1:-}}"
if [[ ! "$tag" =~ ^[0-9a-f]{7,40}$ ]]; then
    echo "usage: thoth-deploy <git-sha>  (compose files as a tar on stdin)" >&2
    exit 2
fi

cd {{ app_dir }}
exec 9>.deploy.lock
flock -n 9 || { echo "another deploy is running" >&2; exit 1; }

if [[ ! -f .env.prod ]]; then
    echo "{{ app_dir }}/.env.prod is missing" >&2
    exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/bundle.tar"
if [[ -s "$tmp/bundle.tar" ]]; then
    tar -x -C "$tmp" -f "$tmp/bundle.tar" compose.yaml compose.prod.yaml
    install -m 0644 "$tmp/compose.yaml" "$tmp/compose.prod.yaml" .
fi

export IMAGE_TAG="$tag" THOTH_ENV_FILE=.env.prod
compose=(docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml)

echo "==> Logging in to ECR"
aws ecr get-login-password --profile {{ ecr_aws_profile }} --region {{ aws_region }} \
    | docker login --username AWS --password-stdin {{ ecr_registry }}

echo "==> Pulling $tag"
"${compose[@]}" pull web api

echo "==> Starting"
"${compose[@]}" up -d --remove-orphans

echo "==> Waiting for the site to respond"
for _ in $(seq 30); do
    if curl -fsS -o /dev/null http://127.0.0.1:{{ app_port }}/; then
        break
    fi
    sleep 2
done
curl -fsS -o /dev/null http://127.0.0.1:{{ app_port }}/ || { echo "web did not come up" >&2; "${compose[@]}" ps; exit 1; }

# A crash-looping API still lets nginx serve the SPA, so check it separately.
sleep 5
state="$(docker inspect -f '{{ '{{.State.Status}} {{.RestartCount}}' }}' "$("${compose[@]}" ps -q api)")"
if [[ "$state" != "running 0" ]]; then
    echo "api is unhealthy ($state):" >&2
    "${compose[@]}" logs --tail 50 api >&2
    exit 1
fi

echo "$tag" > DEPLOYED
docker image prune -af --filter "until=168h" > /dev/null
echo "==> Deployed $tag"
