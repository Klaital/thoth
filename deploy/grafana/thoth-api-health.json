            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "3m",
      "id": 14,
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Connection pool",
      "description": "If in-use reaches max open, requests queue for a connection (see waits).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (db_sql_connection_open{job=\"$job\"})",
          "legendFormat": "{{status}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(db_sql_connection_max_open{job=\"$job\"})",
          "legendFormat": "max open",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
