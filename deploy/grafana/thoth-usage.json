      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(target_info, job)",
          "refId": "job"
        },
        "definition": "label_values(target_info, job)",
        "regex": "/^thoth-/",
        "current": {
          "text": "thoth-api",
          "value": "thoth-api"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
